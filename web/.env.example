# Site URL - used for canonical URLs, OG images, sitemap
# Development: http://localhost:4321
# Production: https://www.buurtkompas.be
PUBLIC_SITE_URL=https://www.buurtkompas.be

# Google Analytics 4 Measurement ID
# Get this from https://analytics.google.com/
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Database connection (for data loading scripts)
# MCP uses a separate read-only user configured in .claude/settings.local.json
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/buurtkompas
