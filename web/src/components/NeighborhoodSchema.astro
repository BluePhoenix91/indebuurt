---
interface Props {
  name: string;
  description: string;
  city: string;
  postalCode: string;
  latitude: number;
  longitude: number;
  url: string;
}

const { name, description, city, postalCode, latitude, longitude, url } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Neighborhood",
  name: `${name}, ${city}`,
  description: description,
  address: {
    "@type": "PostalAddress",
    addressLocality: city,
    postalCode: postalCode,
    addressCountry: "BE",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: latitude,
    longitude: longitude,
  },
  url: url,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} />
