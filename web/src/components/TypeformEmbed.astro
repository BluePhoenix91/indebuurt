---
interface Props {
  typeformId: string;
  className?: string;
  initialHeight?: number; // Initial height in pixels (default: 400px)
}

const { typeformId, className = "", initialHeight = 400 } = Astro.props;
---

<div class={`typeform-container ${className}`}>
  <div
    class="typeform-wrapper"
    data-tf-live={typeformId}
    data-tf-opacity="100"
    data-tf-iframe-props={`title=Feedback form`}
    data-tf-transitive-search-params
    data-tf-medium="snippet"
    aria-label="Feedback form"
    style={`min-height: ${initialHeight}px;`}
  >
  </div>
</div>

<style>
  .typeform-container {
    position: relative;
    width: 100%;
    contain: layout style paint;
  }

  .typeform-wrapper {
    display: block;
    width: 100%;

    /* Let Typeform handle the actual height - it will auto-resize */

    /* We only set min-height to prevent layout shift */
  }
</style>

<script define:vars={{ typeformId, initialHeight }}>
  // Lazy load Typeform when container enters viewport; re-init after ClientRouter navigations
  function initTypeformEmbed() {
    const wrapper = document.querySelector(`[data-tf-live="${typeformId}"]`);
    if (!wrapper || wrapper._typeformInitialized) return;
    wrapper._typeformInitialized = true;

    const container = wrapper.closest(".typeform-container");
    if (!container) return;

    function onEmbedReady() {
      if (typeof window !== "undefined" && window.gtag) {
        window.gtag("event", "typeform_loaded", {
          event_category: "engagement",
          event_label: "contribution_form",
        });
      }

      setTimeout(function () {
        wrapper.style.minHeight = "auto";
      }, 1000);
    }

    function activateEmbed() {
      if (window.tf && typeof window.tf.load === "function") {
        // Script already loaded (e.g. after ClientRouter navigation) — init new snippets
        window.tf.load();
        onEmbedReady();
        return;
      }

      if (document.querySelector('script[src*="embed.typeform.com"]')) {
        // Script tag exists but API not ready yet — wait then load
        const existing = document.querySelector(
          'script[src*="embed.typeform.com"]'
        );
        existing.addEventListener("load", function () {
          if (window.tf && typeof window.tf.load === "function") {
            window.tf.load();
          }
          onEmbedReady();
        });
        return;
      }

      const script = document.createElement("script");
      script.src = "https://embed.typeform.com/next/embed.js";
      script.async = true;
      script.onload = function () {
        onEmbedReady();
      };
      document.body.appendChild(script);
    }

    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            activateEmbed();
            observer.disconnect();
          }
        });
      },
      {
        rootMargin: "200px",
      }
    );

    observer.observe(container);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTypeformEmbed);
  } else {
    initTypeformEmbed();
  }

  document.addEventListener("astro:page-load", initTypeformEmbed);
</script>
