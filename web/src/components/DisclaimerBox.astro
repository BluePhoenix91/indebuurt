---
interface Props {
  message: string;
}

const { message } = Astro.props;
---

<div class="disclaimer-box">
  <div class="disclaimer-icon">
    <i class="fa-regular fa-circle-info"></i>
  </div>
  <p class="disclaimer-message">{message}</p>
</div>

<style lang="scss">
  @use "../styles/variables" as *;

  .disclaimer-box {
    display: flex;
    gap: $spacing-md;
    padding: $spacing-lg;
    margin: $spacing-xl 0;
    background: #fffbea;
    border: 1px solid #ffeaa7;
    border-radius: $radius-md;
  }

  .disclaimer-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    font-size: 20px;
    color: #f39c12;
  }

  .disclaimer-message {
    flex: 1;
    margin: 0;
    font-size: $font-sm;
    line-height: 1.6;
    color: $black;
  }
</style>
