---
import InteractiveMap from "./InteractiveMap.astro";

interface Marker {
  lat: number;
  lon: number;
  name: string;
  number?: number;
}

interface Props {
  id: string;
  title: string;
  center: {
    lat: number;
    lon: number;
    zoom: number;
  };
  markers?: Marker[];
  markerColor?: string;
}

const { id, title, center, markers = [], markerColor = "#ff7a70" } = Astro.props;
const modalId = `map-modal-${id}`;
---

<div id={modalId} class="map-modal" role="dialog" aria-labelledby={`${modalId}-title`} aria-modal="true">
  <div class="map-modal-backdrop" data-close-modal={modalId}></div>
  <div class="map-modal-content">
    <header class="map-modal-header">
      <h2 id={`${modalId}-title`} class="map-modal-title">{title}</h2>
      <button class="map-modal-close" data-close-modal={modalId} aria-label="Sluit kaart">
        <i class="fa-regular fa-xmark"></i>
      </button>
    </header>
    <div class="map-modal-body">
      <InteractiveMap
        center={center}
        markers={markers}
        height="100%"
        className="map-modal-map"
        markerColor={markerColor}
      />
    </div>
  </div>
</div>

<script define:vars={{ modalId }}>
  function initMapModal() {
    const modal = document.getElementById(modalId);
    if (!modal || modal._initialized) return;
    modal._initialized = true;

    // Escape stacking contexts so the full-screen modal covers the viewport
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    // Open modal function
    window[`openMapModal_${modalId}`] = function () {
      modal.classList.add("is-open");
      document.body.style.overflow = "hidden";

      // Initialize any pending maps in this modal and invalidate existing maps
      setTimeout(function () {
        if (window.initPendingMaps) {
          window.initPendingMaps(modal);
        }

        const maps = modal.querySelectorAll("[data-map-id]");
        maps.forEach(function (mapContainer) {
          if (mapContainer._leafletMap) {
            mapContainer._leafletMap.invalidateSize();
          }
        });
      }, 100);
    };

    function closeModal() {
      modal.classList.remove("is-open");
      document.body.style.overflow = "";
    }

    const closeButtons = modal.querySelectorAll(
      `[data-close-modal="${modalId}"]`
    );
    closeButtons.forEach(function (button) {
      button.addEventListener("click", closeModal);
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && modal.classList.contains("is-open")) {
        closeModal();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMapModal);
  } else {
    initMapModal();
  }

  // Re-initialize after Astro ClientRouter navigations
  document.addEventListener("astro:page-load", initMapModal);

  // Modals are moved to <body>, so remove them before swap or they orphan
  document.addEventListener("astro:before-swap", function () {
    document.querySelectorAll("#" + modalId).forEach(function (el) {
      el.remove();
    });
    delete window[`openMapModal_${modalId}`];
  });
</script>

<style>
  .map-modal {
    position: fixed !important;
    inset: 0 !important;
    z-index: 9999 !important;
    display: flex;
    visibility: hidden;
    align-items: center;
    justify-content: center;
    isolation: isolate;
    opacity: 0;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .map-modal.is-open {
    visibility: visible;
    opacity: 1;
  }

  .map-modal-backdrop {
    position: absolute;
    inset: 0;
    cursor: pointer;
    background-color: rgb(0 0 0 / 75%);
  }

  .map-modal-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: white;
    transform: scale(0.95);
    transition: transform 0.3s ease;
  }

  .map-modal.is-open .map-modal-content {
    transform: scale(1);
  }

  .map-modal-header {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid #e8e8e8;
  }

  .map-modal-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: #2a2a2a;
  }

  .map-modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    font-size: 1.5rem;
    color: #898989;
    cursor: pointer;
    background: none;
    border: none;
    border-radius: 0.5rem;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .map-modal-close:hover {
    color: #2a2a2a;
    background-color: #e8e8e8;
  }

  .map-modal-body {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .map-modal-map {
    height: 100%;
    border-radius: 0;
  }

  @media (width >= 48rem) {
    .map-modal-content {
      width: 90%;
      max-width: 1200px;
      height: 90%;
      max-height: 800px;
      border-radius: 1.25rem;
      box-shadow: 0 4px 16px rgb(0 0 0 / 12%);
    }

    .map-modal-map {
      border-radius: 0 0 1.25rem 1.25rem;
    }
  }
</style>

