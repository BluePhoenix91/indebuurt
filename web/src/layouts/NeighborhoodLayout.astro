---
import { ClientRouter } from 'astro:transitions';
import '../styles/styles.scss';
import '@awesome.me/kit-ee3e3d9cbc/icons/css/all.css';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import NeighborhoodSchema from '../components/NeighborhoodSchema.astro';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface NeighborhoodSchemaData {
  name: string;
  description: string;
  city: string;
  postalCode: string;
  latitude: number;
  longitude: number;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  heroImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  neighborhoodSchema?: NeighborhoodSchemaData;
}

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogUrl = canonical,
  ogImage = '/favicon.svg',
  heroImage,
  breadcrumbs,
  neighborhoodSchema
} = Astro.props;

const GA4_MEASUREMENT_ID = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const isProduction = import.meta.env.PROD;
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Preload LCP image for better performance -->
    {heroImage && (
      <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
    )}

    <!-- Open Graph / Social Media -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />

    <!-- Schema.org Structured Data -->
    {breadcrumbs && <BreadcrumbSchema items={breadcrumbs} />}
    {neighborhoodSchema && (
      <NeighborhoodSchema
        name={neighborhoodSchema.name}
        description={neighborhoodSchema.description}
        city={neighborhoodSchema.city}
        postalCode={neighborhoodSchema.postalCode}
        latitude={neighborhoodSchema.latitude}
        longitude={neighborhoodSchema.longitude}
        url={neighborhoodSchema.url}
      />
    )}

    <!-- Google Analytics 4 (Production only) -->
    {isProduction && GA4_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA4_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA4_MEASUREMENT_ID);
        </script>
      </>
    )}
  </head>
  <body>
    <header transition:persist>
      <nav>
        <a href="/">buurtkompas.be</a>
      </nav>
    </header>

    <main transition:animate="fade">
      <slot />
    </main>

    <footer transition:persist>
      <p>&copy; {new Date().getFullYear()} buurtkompas.be</p>
    </footer>
  </body>
</html>
